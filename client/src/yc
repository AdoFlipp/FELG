import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useAuth } from "../context/AuthContext";

function Login() {
  const navigate = useNavigate();
  const { login } = useAuth();

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (event) => {
    event.preventDefault();

    setError("");
    setLoading(true);

    try {
      await login({
        email,
        password,
      });

      navigate("/dashboard");
    } catch (error) {
      setError(error.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="auth-page">

      <div className="auth-card">

        <div className="auth-header">

          <h1>Welcome back</h1>

          <p>
            Log in to continue your FELG journey.
          </p>

        </div>

        {error && (
          <div className="error-message">
            {error}
          </div>
        )}

        <form onSubmit={handleSubmit}>

          <div className="form-group">

            <label>Email</label>

            <input
              type="email"
              value={email}
              onChange={(event) =>
                setEmail(event.target.value)
              }
              required
            />

          </div>

          <div className="form-group">

            <label>Password</label>

            <input
              type="password"
              value={password}
              onChange={(event) =>
                setPassword(event.target.value)
              }
              required
            />

          </div>

          <button
            type="submit"
            className="auth-button"
            disabled={loading}
          >
            {loading
              ? "Signing in..."
              : "Log in"}
          </button>

        </form>

        <p className="auth-footer">

          Don't have an account?

          {" "}

          <Link to="/register">
            Create one
          </Link>

        </p>

      </div>

    </div>
  );
}

export default Login;





















import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useAuth } from "../../context/AuthContext";

function Register() {
  const navigate = useNavigate();
  const { register } = useAuth();

  const [form, setForm] = useState({
    firstName: "",
    lastName: "",
    email: "",
    password: "",
    role: "graduate",
    country: "",
    city: "",
  });

  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const handleChange = (event) => {
    setForm({
      ...form,
      [event.target.name]: event.target.value,
    });
  };

  const handleSubmit = async (event) => {
    event.preventDefault();

    setError("");
    setLoading(true);

    try {
      await register(form);

      navigate("/dashboard");
    } catch (error) {
      setError(error.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="auth-page">

      <div className="auth-card">

        <div className="auth-header">
          <h1>Join FELG</h1>

          <p>
            Create your account and start building
            your future.
          </p>
        </div>

        {error && (
          <div className="error-message">
            {error}
          </div>
        )}

        <form onSubmit={handleSubmit}>

          <div className="form-row">

            <div className="form-group">
              <label>First name</label>

              <input
                type="text"
                name="firstName"
                value={form.firstName}
                onChange={handleChange}
                required
              />
            </div>

            <div className="form-group">
              <label>Last name</label>

              <input
                type="text"
                name="lastName"
                value={form.lastName}
                onChange={handleChange}
                required
              />
            </div>

          </div>

          <div className="form-group">

            <label>Email</label>

            <input
              type="email"
              name="email"
              value={form.email}
              onChange={handleChange}
              required
            />

          </div>

          <div className="form-group">

            <label>Password</label>

            <input
              type="password"
              name="password"
              value={form.password}
              onChange={handleChange}
              minLength="8"
              required
            />

          </div>

          <div className="form-group">

            <label>FELG account type</label>

            <select
              name="role"
              value={form.role}
              onChange={handleChange}
            >

              <option value="student">
                Student
              </option>

              <option value="graduate">
                Graduate
              </option>

              <option value="employer">
                Employer
              </option>

              <option value="university">
                University
              </option>

              <option value="college">
                College
              </option>

              <option value="startup">
                Startup
              </option>

              <option value="mentor">
                Mentor
              </option>

            </select>

          </div>

          <div className="form-row">

            <div className="form-group">

              <label>Country</label>

              <input
                type="text"
                name="country"
                value={form.country}
                onChange={handleChange}
              />

            </div>

            <div className="form-group">

              <label>City</label>

              <input
                type="text"
                name="city"
                value={form.city}
                onChange={handleChange}
              />

            </div>

          </div>

          <button
            type="submit"
            className="auth-button"
            disabled={loading}
          >
            {loading
              ? "Creating account..."
              : "Create FELG account"}
          </button>

        </form>

        <p className="auth-footer">

          Already have an account?

          {" "}

          <Link to="/login">
            Log in
          </Link>

        </p>

      </div>

    </div>
  );
}

export default Register;













































































const pool = require("../config/database");

const globalSearch = async (req, res) => {
  try {
    const {
      q = "",
      country = "",
      type = "all",
    } = req.query;

    const search = q.trim();

    if (!search && !country) {
      return res.json({
        success: true,
        results: {
          people: [],
          jobs: [],
          programs: [],
          organizations: [],
          startups: [],
          mentors: [],
          opportunities: [],
        },
      });
    }

    const pattern = `%${search}%`;

    const results = {
      people: [],
      jobs: [],
      programs: [],
      organizations: [],
      startups: [],
      mentors: [],
      opportunities: [],
    };


    // ==========================================
    // PEOPLE
    // ==========================================

    if (type === "all" || type === "people") {
      const values = [pattern];

      let countryCondition = "";

      if (country) {
        values.push(country);
        countryCondition =
          `AND u.country = $${values.length}`;
      }

      const result = await pool.query(
        `
        SELECT
          u.id,
          u.first_name,
          u.last_name,
          u.role,
          u.country,
          u.city,

          p.headline,
          p.bio,
          p.profile_photo_url

        FROM users u

        LEFT JOIN profiles p
          ON p.user_id = u.id

        WHERE u.is_active = true

        AND (
          u.first_name ILIKE $1
          OR u.last_name ILIKE $1
          OR p.headline ILIKE $1
          OR p.bio ILIKE $1
        )

        ${countryCondition}

        ORDER BY u.created_at DESC

        LIMIT 20
        `,
        values
      );

      results.people = result.rows;
    }


    // ==========================================
    // JOBS
    // ==========================================

    if (type === "all" || type === "jobs") {
      const values = [pattern];

      let countryCondition = "";

      if (country) {
        values.push(country);

        countryCondition =
          `AND j.country = $${values.length}`;
      }

      const result = await pool.query(
        `
        SELECT
          j.id,
          j.title,
          j.description,
          j.country,
          j.city,
          j.work_type,

          o.name AS organization_name

        FROM jobs j

        LEFT JOIN organizations o
          ON o.id = j.organization_id

        WHERE j.is_active = true

        AND (
          j.title ILIKE $1
          OR j.description ILIKE $1
          OR o.name ILIKE $1
        )

        ${countryCondition}

        ORDER BY j.created_at DESC

        LIMIT 20
        `,
        values
      );

      results.jobs = result.rows;
    }


    // ==========================================
    // PROGRAMS
    // ==========================================

    if (type === "all" || type === "programs") {
      const values = [pattern];

      let countryCondition = "";

      if (country) {
        values.push(country);

        countryCondition =
          `AND o.country = $${values.length}`;
      }

      const result = await pool.query(
        `
        SELECT
          p.id,
          p.name,
          p.description,
          p.degree_level,
          p.duration,
          p.application_deadline,

          o.name AS organization_name,
          o.country

        FROM programs p

        JOIN organizations o
          ON o.id = p.organization_id

        WHERE
          (
            p.name ILIKE $1
            OR p.description ILIKE $1
            OR p.degree_level ILIKE $1
            OR o.name ILIKE $1
          )

        ${countryCondition}

        ORDER BY p.created_at DESC

        LIMIT 20
        `,
        values
      );

      results.programs = result.rows;
    }


    // ==========================================
    // ORGANIZATIONS
    // ==========================================

    if (
      type === "all" ||
      type === "organizations"
    ) {
      const values = [pattern];

      let countryCondition = "";

      if (country) {
        values.push(country);

        countryCondition =
          `AND o.country = $${values.length}`;
      }

      const result = await pool.query(
        `
        SELECT
          o.id,
          o.name,
          o.type,
          o.description,
          o.country,
          o.city,
          o.website,
          o.is_verified

        FROM organizations o

        WHERE o.is_active = true

        AND (
          o.name ILIKE $1
          OR o.description ILIKE $1
        )

        ${countryCondition}

        ORDER BY o.created_at DESC

        LIMIT 20
        `,
        values
      );

      results.organizations =
        result.rows;
    }


    // ==========================================
    // STARTUPS
    // ==========================================

    if (
      type === "all" ||
      type === "startups"
    ) {
      const values = [pattern];

      let countryCondition = "";

      if (country) {
        values.push(country);

        countryCondition =
          `AND s.country = $${values.length}`;
      }

      const result = await pool.query(
        `
        SELECT
          s.id,
          s.name,
          s.description,
          s.industry,
          s.stage,
          s.country,
          s.city,
          s.website,
          s.logo_url

        FROM startups s

        WHERE (
          s.name ILIKE $1
          OR s.description ILIKE $1
          OR s.industry ILIKE $1
        )

        ${countryCondition}

        ORDER BY s.created_at DESC

        LIMIT 20
        `,
        values
      );

      results.startups = result.rows;
    }


    // ==========================================
    // MENTORS
    // ==========================================

    if (
      type === "all" ||
      type === "mentors"
    ) {
      const result = await pool.query(
        `
        SELECT
          u.id,
          u.first_name,
          u.last_name,
          u.country,
          u.city,

          p.headline,
          p.bio,
          p.profile_photo_url

        FROM users u

        LEFT JOIN profiles p
          ON p.user_id = u.id

        WHERE u.role = 'mentor'

        AND u.is_active = true

        AND (
          u.first_name ILIKE $1
          OR u.last_name ILIKE $1
          OR p.headline ILIKE $1
          OR p.bio ILIKE $1
        )

        ORDER BY u.created_at DESC

        LIMIT 20
        `,
        [pattern]
      );

      results.mentors =
        result.rows;
    }


    // ==========================================
    // STARTUP OPPORTUNITIES
    // ==========================================

    if (
      type === "all" ||
      type === "opportunities"
    ) {
      const result = await pool.query(
        `
        SELECT
          so.id,
          so.startup_id,
          so.title,
          so.description,
          so.opportunity_type,
          so.location,
          so.is_remote,
          so.skills,

          s.name AS startup_name,
          s.country

        FROM startup_opportunities so

        JOIN startups s
          ON s.id = so.startup_id

        WHERE so.is_active = true

        AND (
          so.title ILIKE $1
          OR so.description ILIKE $1
          OR so.skills ILIKE $1
          OR s.name ILIKE $1
        )

        ORDER BY so.created_at DESC

        LIMIT 20
        `,
        [pattern]
      );

      results.opportunities =
        result.rows;
    }


    res.json({
      success: true,
      query: search,
      results,
    });

  } catch (error) {
    console.error(
      "Global search error:",
      error
    );

    res.status(500).json({
      success: false,
      message:
        "Global search failed",
    });
  }
};

module.exports = {
  globalSearch,
};





















